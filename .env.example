# AI / Gemini API
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
USE_LANGCHAIN="false"

# Application URL & Server
APP_URL="MY_APP_URL"
NODE_ENV="development"
PORT="5000"
CORS_ORIGIN="http://localhost:3000"

# Optional GitHub API token to increase GitHub REST API rate limits
GITHUB_TOKEN=""

# Workspace & Security Limits
UPLOAD_DIR="/tmp/codemind-workspaces"
MAX_UPLOAD_SIZE_MB="25"
MAX_UNCOMPRESSED_SIZE_MB="80"
MAX_FILE_SIZE_KB="512"
MAX_FILES_PER_PROJECT="1500"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="120"

# Relational DB (MySQL)
MYSQL_URL="mysql://codemind:codemind_pass@mysql:3306/codemind"
MYSQL_HOST="mysql"
MYSQL_PORT="3306"
MYSQL_USER="codemind"
MYSQL_PASSWORD="codemind_pass"
MYSQL_DATABASE="codemind"

# Document DB (MongoDB)
MONGODB_URL="mongodb://mongodb:27017/codemind"

# Vector DB (ChromaDB)
CHROMA_URL="http://chromadb:8000"
